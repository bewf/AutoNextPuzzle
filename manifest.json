{
  "manifest_version": 3,
  "name": "AutoNextPuzzle",
  "version": "2.0.0",
  "description": "Automatically advances to the next Chess.com puzzle or retries failed puzzles.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "autonextpuzzle@bewfon.top",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_title": "AutoNextPuzzle",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/puzzles*"
      ],
      "js": [
        "src/storage.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
